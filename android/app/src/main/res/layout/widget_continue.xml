<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher_round" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Continue watching"
            android:textColor="#F0F0F0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Start watching something and it shows up here"
        android:textColor="#909090"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/w_item0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/w_poster0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="#222222" />
            <ProgressBar
                android:id="@+id/w_progress0"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />
            <TextView
                android:id="@+id/w_title0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F0F0F0"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_sub0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#909090"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_item1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/w_poster1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="#222222" />
            <ProgressBar
                android:id="@+id/w_progress1"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />
            <TextView
                android:id="@+id/w_title1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F0F0F0"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_sub1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#909090"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/w_item2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/w_poster2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scaleType="centerCrop"
                android:background="#222222" />
            <ProgressBar
                android:id="@+id/w_progress2"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />
            <TextView
                android:id="@+id/w_title2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F0F0F0"
                android:textSize="12sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/w_sub2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#909090"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
